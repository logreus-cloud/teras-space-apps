# SI provider: claude | gemini | ollama (auto if empty: Claude when ANTHROPIC_API_KEY is set)
LLM_PROVIDER=
# Claude (https://console.anthropic.com) — used at the hackathon
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# Gemini free tier (https://aistudio.google.com/apikey) — for testing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried when the main model is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Local model on a teammate's GPU via Ollama (set LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Context window in tokens (8192 fits an 8 GB GPU)
OLLAMA_NUM_CTX=8192
# Bearer token if Ollama is exposed through an authenticated tunnel
OLLAMA_API_KEY=
# Fall back to Claude/Gemini when the local model is unreachable (1/0)
LLM_CLOUD_FALLBACK=1
